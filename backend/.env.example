PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/vector_advert_full_erp
JWT_SECRET=vector_advert_erp_secret_key_2026
JWT_EXPIRE=30d
NODE_ENV=development

# Email (Nodemailer) Configuration
# Example using SMTP (Gmail, SendGrid, Mailgun, Amazon SES, Brevo, or custom SMTP):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_or_smtp_password
EMAIL_FROM=Vector Advert ERP <no-reply@vectoradvert.com>

# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram to get your token and username
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=VectorAdvertBot

# Master Control Microservice (Option 1)
CONTROL_FAIL_CLOSED=false
